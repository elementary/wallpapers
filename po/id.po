#: data/wallpapers.metainfo.xml.in:10
msgid "elementary Wallpapers"
msgstr "Gambar Latar elementary"

#: data/wallpapers.metainfo.xml.in:11
msgid "Curated wallpapers for elementary OS"
msgstr "Gambar latar yang dikurasi untuk elementary OS"

#: data/wallpapers.metainfo.xml.in:21
msgid "elementary, Inc."
msgstr "elementary, Inc."

#: data/wallpapers.metainfo.xml.in:30
msgid ""
"Add “A Large Body of Water Surrounded By Mountains” by Peter Thomas and make "
"it the new default"
msgstr ""
"Tambah “A Large Body of Water Surrounded By Mountains” oleh Peter Thomas dan "
"jadikan bawaan yang baru"

#: data/wallpapers.metainfo.xml.in:31
msgid "Add “A Trail of Footprints In The Sand” by David Emrich"
msgstr "Tambah “A Trail of Footprints In The Sand” oleh David Emrich"

#: data/wallpapers.metainfo.xml.in:32
msgid "Remove “Orange Tulip” by Leigh Kendell"
msgstr "Hapus “Orange Tulip” oleh Leigh Kendell"

#: data/wallpapers.metainfo.xml.in:33
msgid "Remove “Bird Flying by The Mountain” by Julia Craice"
msgstr "Hapus “Bird Flying by The Mountain” oleh Julia Craice"

#: data/wallpapers.metainfo.xml.in:34
msgid "Build a special wallpaper for Early Access"
msgstr "Buat gambar latar khusus untuk Akses Awal"

#: data/wallpapers.metainfo.xml.in:42
msgid "Add \"Photo of Valley\" by Aniket Deole"
msgstr "Tambah \"Photo of Valley\" oleh Aniket Deole"

#: data/wallpapers.metainfo.xml.in:43
msgid "Remove Jonas Nilsson Lee"
msgstr "Hapus Jonas Nilsson Lee"

#: data/wallpapers.metainfo.xml.in:51
msgid "Make Odin Dark the default"
msgstr "Jadikan Odin Dark sebagai bawaan"

#: data/wallpapers.metainfo.xml.in:59
msgid "Add day and night custom Odin wallpapers by Freehive"
msgstr "Tambah gambar latar Odin kustom siang dan malam oleh Freehive"

#: data/wallpapers.metainfo.xml.in:60
msgid ""
"Add Snow-capped Mountain, Martin Adams, Tj Holowaychuk, and Vikor Forgacs"
msgstr ""
"Tambah Snow-capped Mountain, Martin Adams, Tj Holowaychuk, dan Vikor Forgacs"

#: data/wallpapers.metainfo.xml.in:61
msgid ""
"Remove Carmine de Fazio, Luca Bravo, Pablo Garcia Saldana, Rob Bye, and Ryan "
"Schroeder"
msgstr ""
"Hapus Carmine de Fazio, Luca Bravo, Pablo Garcia Saldana, Rob Bye, dan Ryan "
"Schroeder"

#: data/wallpapers.metainfo.xml.in:69
msgid "Change default to Sunset by the Pier"
msgstr "Ubah bawaan ke Sunset by the Pier"
